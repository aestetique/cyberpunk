{{!--
  Shared Effect-tab bonus list — used by cyberware / outfit / tool /
  cyberdeck (netware).

  Context provided by the sheet's getData() via prepareEffectTabContext():
    bonuses          — shaped rows (isAttribute / isProperty / isModifier / isNetBonus / isSkill + label)
    attributeOptions — dropdown options for "Add Attribute" (stats.*)
    propertyOptions  — dropdown options for "Add Property" (boolean toggles)
    modifierOptions  — dropdown options for "Add Modifier" (numeric non-stat)
    netBonusOptions  — dropdown options for "Add NET Bonus"
    isLocked         — sheet lock flag

  Drug has its own copy (parts/drug-bonuses.hbs) because it manages two
  parallel bonus sets (Effect AND Withdrawal) on one sheet; the shape and
  buttons are identical.
--}}
<div class="effect-bonuses" data-drop-target="skill-bonus">
  {{#each bonuses}}
    <div class="bonus-row" data-index="{{@index}}">

      {{#if this.isAttribute}}
        {{!-- Attribute bonus row (stats.*) --}}
        <label class="variable-label">{{localize "CYBERPUNK.Attribute"}}</label>
        {{#if ../isLocked}}
          <div class="dropdown">
            <span class="dropdown-text">{{this.label}}</span>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{else}}
          <div class="dropdown-wrapper">
            <select class="dropdown-select bonus-property-select" data-index="{{@index}}">
              <option value="{{this.property}}" selected>{{this.label}}</option>
              {{#each ../attributeOptions}}
                <option value="{{this.value}}">{{this.label}}</option>
              {{/each}}
            </select>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{/if}}
      {{else if this.isProperty}}
        {{!-- Property bonus row (boolean toggle — presence = 1, no op/value) --}}
        <label class="variable-label">{{localize "CYBERPUNK.Property"}}</label>
        {{#if ../isLocked}}
          <div class="dropdown">
            <span class="dropdown-text">{{this.label}}</span>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{else}}
          <div class="dropdown-wrapper">
            <select class="dropdown-select bonus-property-select" data-index="{{@index}}">
              <option value="{{this.property}}" selected>{{this.label}}</option>
              {{#each ../propertyOptions}}
                <option value="{{this.value}}">{{this.label}}</option>
              {{/each}}
            </select>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{/if}}
      {{else if this.isModifier}}
        {{!-- Modifier row (numeric non-stat — uses op + value UI) --}}
        <label class="variable-label">{{localize "CYBERPUNK.Modifier"}}</label>
        {{#if ../isLocked}}
          <div class="dropdown">
            <span class="dropdown-text">{{this.label}}</span>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{else}}
          <div class="dropdown-wrapper">
            <select class="dropdown-select bonus-property-select" data-index="{{@index}}">
              <option value="{{this.property}}" selected>{{this.label}}</option>
              {{#each ../modifierOptions}}
                <option value="{{this.value}}">{{this.label}}</option>
              {{/each}}
            </select>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{/if}}
      {{else if this.isState}}
        {{!-- State bonus row — Stress/Fright/Fatigue + HL psychosis bonuses --}}
        <label class="variable-label">{{localize "CYBERPUNK.State"}}</label>
        {{#if ../isLocked}}
          <div class="dropdown">
            <span class="dropdown-text">{{this.label}}</span>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{else}}
          <div class="dropdown-wrapper">
            <select class="dropdown-select bonus-property-select" data-index="{{@index}}">
              <option value="{{this.property}}" selected>{{this.label}}</option>
              {{#each ../stateOptions}}
                <option value="{{this.value}}">{{this.label}}</option>
              {{/each}}
            </select>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{/if}}
      {{else if this.isNetBonus}}
        {{!-- NET Bonus row — per-NET-action buff + Cyberdeck Slots --}}
        <label class="variable-label">{{localize "CYBERPUNK.NetBonus"}}</label>
        {{#if ../isLocked}}
          <div class="dropdown">
            <span class="dropdown-text">{{this.label}}</span>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{else}}
          <div class="dropdown-wrapper">
            <select class="dropdown-select bonus-property-select" data-index="{{@index}}">
              <option value="{{this.property}}" selected>{{this.label}}</option>
              {{#each ../netBonusOptions}}
                <option value="{{this.value}}">{{this.label}}</option>
              {{/each}}
            </select>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{/if}}
      {{else}}
        {{!-- Skill bonus row --}}
        <label class="variable-label">{{localize "CYBERPUNK.Skill"}}</label>
        {{#if this.hasFilled}}
          <div class="skill-drop filled">
            <span class="skill-name" data-action="openSkill" data-uuid="{{this.skillUuid}}">{{this.skillName}}</span>
          </div>
        {{else}}
          <div class="skill-drop empty" data-drop-target="skill-bonus">
            <span class="placeholder">{{#if ../isLocked}}{{localize "CYBERPUNK.DropSkillLocked"}}{{else}}{{localize "CYBERPUNK.DropSkillHere"}}{{/if}}</span>
          </div>
        {{/if}}
      {{/if}}

      {{!-- Op + value: skipped for boolean Property rows (presence = 1). --}}
      {{#unless this.isProperty}}
        {{#if ../isLocked}}
          <span class="bonus-op">{{this.op}}</span>
        {{else}}
          <div class="dropdown-wrapper op-wrapper">
            <select class="dropdown-select bonus-op-select" data-index="{{@index}}">
              {{#each this.opOptions}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
            <div class="dropdown-chevron">
              <img src="systems/cyberpunk/img/ui/icon-down.svg" alt="">
            </div>
          </div>
        {{/if}}

        {{#if ../isLocked}}
          <span class="bonus-value">{{this.value}}</span>
        {{else}}
          <input type="number" class="bonus-value-input" data-index="{{@index}}" value="{{this.value}}">
        {{/if}}
      {{/unless}}

      {{!-- Trash icon --}}
      {{#unless ../isLocked}}
        <button type="button" class="remove-bonus" data-index="{{@index}}" title="Remove">
          <img src="systems/cyberpunk/img/ui/icon-trash.svg" alt="Remove">
        </button>
      {{/unless}}
    </div>
  {{/each}}
</div>

{{!-- Action buttons: two rows. Row 1 = Attribute / Property / Modifier;
     Row 2 = Skill / State / NET Bonus. --}}
{{#unless isLocked}}
  <div class="effect-actions">
    <button type="button" class="add-attribute">{{localize "CYBERPUNK.AddAttribute"}}</button>
    <button type="button" class="add-property">{{localize "CYBERPUNK.AddProperty"}}</button>
    <button type="button" class="add-modifier">{{localize "CYBERPUNK.AddModifier"}}</button>
  </div>
  <div class="effect-actions">
    <button type="button" class="add-skill">{{localize "CYBERPUNK.AddSkill"}}</button>
    <button type="button" class="add-state">{{localize "CYBERPUNK.AddState"}}</button>
    <button type="button" class="add-net-bonus">{{localize "CYBERPUNK.AddNetBonus"}}</button>
  </div>
{{/unless}}
